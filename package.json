{
  "name": "barber-shop-api",
  "version": "1.0.0",
  "description": "API REST para gerenciamento de agendamentos de barbearia",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "dev": "node --watch --env-file=.env --import=tsx/esm src/server.ts",
    "build": "tsc",
    "start": "node --env-file=.env dist/server.js",
    "test:coverage": "vitest run --coverage"
